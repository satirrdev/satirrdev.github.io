---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sign In | aBlog by Satirr">
  <div class="wrap" style="max-width: 420px; margin: 0 auto;">
    <h1 id="auth-title" style="margin-bottom: 8px;">Sign in</h1>
    <p class="intro" id="auth-subtitle" style="color: var(--text-secondary); margin-bottom: 28px;">
      Sign in to join the conversation and leave comments.
    </p>

    <!-- Error/Notice box -->
    <div id="auth-msg" style="display: none; padding: 10px 14px; border-radius: 6px; font-size: 14px; margin-bottom: 20px;"></div>

    <!-- OAuth Social Sign In Buttons -->
    <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px;">
      <!-- Google -->
      <button type="button" class="btn-oauth" data-provider="google" style="display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 10px 16px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); color: var(--text); font-weight: 500; font-size: 14px; cursor: pointer; transition: background 0.15s ease;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
        </svg>
        <span>Continue with Google</span>
      </button>

      <!-- GitHub -->
      <button type="button" class="btn-oauth" data-provider="github" style="display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 10px 16px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); color: var(--text); font-weight: 500; font-size: 14px; cursor: pointer; transition: background 0.15s ease;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>Continue with GitHub</span>
      </button>

      <!-- Facebook -->
      <button type="button" class="btn-oauth" data-provider="facebook" style="display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 10px 16px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); color: var(--text); font-weight: 500; font-size: 14px; cursor: pointer; transition: background 0.15s ease;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877F2">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        <span>Continue with Facebook</span>
      </button>
    </div>

    <!-- Divider -->
    <div style="display: flex; align-items: center; margin-bottom: 24px; color: var(--text-secondary); font-size: 13px;">
      <div style="flex: 1; height: 1px; background: var(--border);"></div>
      <span style="padding: 0 12px;">or sign in with email</span>
      <div style="flex: 1; height: 1px; background: var(--border);"></div>
    </div>

    <form id="auth-form">
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">Email</label>
        <input type="email" id="email" placeholder="you@example.com" required />
      </div>

      <div style="margin-bottom: 24px;">
        <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">Password</label>
        <input type="password" id="password" placeholder="At least 6 characters" required minlength="6" />
      </div>

      <button type="submit" class="btn-primary" id="btn-submit" style="width: 100%; text-align: center; margin-bottom: 16px;">
        Sign in
      </button>

      <div style="text-align: center; font-size: 14px; color: var(--text-secondary);">
        <span id="toggle-text">Don't have an account?</span>
        <button type="button" id="btn-toggle-mode" style="background: none; border: none; color: var(--accent); cursor: pointer; padding: 0 4px; font-size: 14px;">
          Create one
        </button>
      </div>
    </form>
  </div>
</Layout>

<script>
  import { supabase, isSupabaseConfigured } from '../lib/supabase';

  let isRegister = false;

  const title = document.getElementById('auth-title')!;
  const subtitle = document.getElementById('auth-subtitle')!;
  const submitBtn = document.getElementById('btn-submit') as HTMLButtonElement;
  const toggleBtn = document.getElementById('btn-toggle-mode') as HTMLButtonElement;
  const toggleText = document.getElementById('toggle-text')!;
  const msgBox = document.getElementById('auth-msg')!;
  const form = document.getElementById('auth-form') as HTMLFormElement;

  toggleBtn.addEventListener('click', () => {
    isRegister = !isRegister;
    hideMsg();
    if (isRegister) {
      title.textContent = 'Create Account';
      subtitle.textContent = 'Register an account to comment on articles.';
      submitBtn.textContent = 'Sign up';
      toggleText.textContent = 'Already have an account?';
      toggleBtn.textContent = 'Sign in here';
    } else {
      title.textContent = 'Sign in';
      subtitle.textContent = 'Sign in to join the conversation and leave comments.';
      submitBtn.textContent = 'Sign in';
      toggleText.textContent = "Don't have an account?";
      toggleBtn.textContent = 'Create one';
    }
  });

  function showMsg(text: string, isError = true) {
    msgBox.style.display = 'block';
    msgBox.textContent = text;
    if (isError) {
      msgBox.style.background = 'rgba(235, 87, 87, 0.1)';
      msgBox.style.color = 'var(--danger)';
      msgBox.style.border = '1px solid var(--danger)';
    } else {
      msgBox.style.background = 'var(--surface)';
      msgBox.style.color = 'var(--text)';
      msgBox.style.border = '1px solid var(--border)';
    }
  }

  function hideMsg() {
    msgBox.style.display = 'none';
  }

  // OAuth Sign In
  document.querySelectorAll('.btn-oauth').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const provider = (e.currentTarget as HTMLElement).getAttribute('data-provider') as 'google' | 'github' | 'facebook';
      hideMsg();

      if (!isSupabaseConfigured) {
        showMsg(`Social sign in with ${provider} requires live Supabase credentials.`, true);
        return;
      }

      try {
        const { error } = await supabase.auth.signInWithOAuth({
          provider: provider,
          options: {
            redirectTo: window.location.origin + '/'
          }
        });
        if (error) {
          showMsg(error.message, true);
        }
      } catch (err: any) {
        showMsg(err.message || 'OAuth error', true);
      }
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideMsg();

    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;

    submitBtn.disabled = true;
    submitBtn.textContent = isRegister ? 'Signing up...' : 'Signing in...';

    if (isRegister) {
      const { data, error } = await supabase.auth.signUp({
        email,
        password
      });

      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign up';

      if (error) {
        showMsg(error.message, true);
      } else {
        showMsg('Registration successful! Please check your email for a confirmation link (if enabled) or sign in directly.', false);
      }
    } else {
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password
      });

      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign in';

      if (error) {
        showMsg(error.message, true);
      } else {
        window.location.href = '/';
      }
    }
  });

  supabase.auth.getSession().then(({ data: { session } }) => {
    if (session) {
      window.location.href = '/';
    }
  });
</script>
