---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sign In | aBlog by Satirr">
  <!-- Cloudflare Turnstile Script -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <div class="wrap" style="max-width: 420px; margin: 0 auto;">
    <h1 id="auth-title" style="margin-bottom: 8px;">Sign in</h1>
    <p class="intro" id="auth-subtitle" style="color: var(--text-secondary); margin-bottom: 28px;">
      Sign in to join the conversation and leave comments.
    </p>

    <!-- Error/Notice box -->
    <div id="auth-msg" style="display: none; padding: 10px 14px; border-radius: 6px; font-size: 14px; margin-bottom: 20px;"></div>

    <form id="auth-form">
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">Email</label>
        <input type="email" id="email" placeholder="you@example.com" required />
      </div>

      <div style="margin-bottom: 20px;">
        <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">Password</label>
        <input type="password" id="password" placeholder="At least 6 characters" required minlength="6" />
      </div>

      <!-- Cloudflare Turnstile Widget -->
      <div style="margin-bottom: 20px; display: flex; justify-content: center;">
        <div class="cf-turnstile" data-sitekey="0x4AAAAAAFaAfj1hf7KC0_00" data-theme="auto" data-callback="onTurnstileSuccess"></div>
      </div>

      <button type="submit" class="btn-primary" id="btn-submit" style="width: 100%; text-align: center; margin-bottom: 16px;">
        Sign in
      </button>

      <div style="text-align: center; font-size: 14px; color: var(--text-secondary); cursor: pointer;">
        <span id="toggle-text">Don't have an account?</span>
        <button type="button" id="btn-toggle-mode" style="background: none; border: none; color: var(--accent); cursor: pointer; padding: 0 4px; font-size: 14px;">
          Create one
        </button>
      </div>
    </form>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { waitForVerification } from '../lib/verification';

  let isRegister = false;
  let turnstileToken = '';

  (window as any).onTurnstileSuccess = function(token: string) {
    turnstileToken = token;
  };

  const title = document.getElementById('auth-title')!;
  const subtitle = document.getElementById('auth-subtitle')!;
  const submitBtn = document.getElementById('btn-submit') as HTMLButtonElement;
  const toggleBtn = document.getElementById('btn-toggle-mode') as HTMLButtonElement;
  const toggleText = document.getElementById('toggle-text')!;
  const msgBox = document.getElementById('auth-msg')!;
  const form = document.getElementById('auth-form') as HTMLFormElement;

  const SIGNUP_LIMIT_KEY = 'satirr_signup_timestamps';
  const MAX_SIGNUPS = 2;
  const SIGNUP_WINDOW_MS = 5 * 60 * 60 * 1000; // 5 hours

  function getRecentSignups(): number[] {
    try {
      const raw = localStorage.getItem(SIGNUP_LIMIT_KEY);
      if (!raw) return [];
      const times: number[] = JSON.parse(raw);
      const now = Date.now();
      return times.filter(t => now - t < SIGNUP_WINDOW_MS);
    } catch {
      return [];
    }
  }

  function recordSignupAttempt() {
    try {
      const times = getRecentSignups();
      times.push(Date.now());
      localStorage.setItem(SIGNUP_LIMIT_KEY, JSON.stringify(times));
    } catch {}
  }

  toggleBtn.addEventListener('click', () => {
    isRegister = !isRegister;
    hideMsg();
    if (isRegister) {
      title.textContent = 'Create Account';
      subtitle.textContent = 'Register an account to comment on articles.';
      submitBtn.textContent = 'Sign up';
      toggleText.textContent = 'Already have an account?';
      toggleBtn.textContent = 'Sign in here';
    } else {
      title.textContent = 'Sign in';
      subtitle.textContent = 'Sign in to join the conversation and leave comments.';
      submitBtn.textContent = 'Sign in';
      toggleText.textContent = "Don't have an account?";
      toggleBtn.textContent = 'Create one';
    }
  });

  function showMsg(text: string, isError = true) {
    msgBox.style.display = 'block';
    msgBox.textContent = text;
    if (isError) {
      msgBox.style.background = 'rgba(235, 87, 87, 0.1)';
      msgBox.style.color = 'var(--danger)';
      msgBox.style.border = '1px solid var(--danger)';
    } else {
      msgBox.style.background = 'var(--surface)';
      msgBox.style.color = 'var(--text)';
      msgBox.style.border = '1px solid var(--border)';
    }
  }

  function hideMsg() {
    msgBox.style.display = 'none';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideMsg();

    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;

    if (isRegister) {
      const recentSignups = getRecentSignups();
      if (recentSignups.length >= MAX_SIGNUPS) {
        showMsg('Signup limit reached: Maximum 2 accounts per 5 hours from this device. Please try again later.', true);
        return;
      }
    }

    const turnstileInput = document.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement;
    const captchaToken = turnstileToken || turnstileInput?.value || '';

    submitBtn.disabled = true;
    submitBtn.textContent = isRegister ? 'Signing up...' : 'Signing in...';

    if (isRegister) {
      const signUpOptions: any = {
        email,
        password
      };

      if (captchaToken) {
        signUpOptions.options = {
          captchaToken: captchaToken
        };
      }

      const { data, error } = await supabase.auth.signUp(signUpOptions);

      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign up';

      if (error) {
        showMsg(error.message, true);
        if ((window as any).turnstile) {
          (window as any).turnstile.reset();
        }
      } else {
        recordSignupAttempt();
        showMsg('Registration successful! You can now sign in directly.', false);
        setTimeout(() => {
          if (isRegister) toggleBtn.click();
        }, 1500);
      }
    } else {
      const signInOptions: any = {
        email,
        password
      };

      if (captchaToken) {
        signInOptions.options = {
          captchaToken: captchaToken
        };
      }

      const { data, error } = await supabase.auth.signInWithPassword(signInOptions);

      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign in';

      if (error) {
        showMsg(error.message, true);
        if ((window as any).turnstile) {
          (window as any).turnstile.reset();
        }
      } else {
        window.location.href = '/';
      }
    }
  });

  waitForVerification().then(() => {
    supabase.auth.getSession().then(({ data: { session } }) => {
      if (session) {
        window.location.href = '/';
      }
    });
  });
</script>
