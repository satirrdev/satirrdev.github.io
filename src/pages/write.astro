---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tulis Post — satirr ai">
  <div class="wrap">
    <div id="auth-check" style="color: var(--text-secondary); font-size: 15px;">
      Memeriksa hak akses admin...
    </div>

    <div id="unauthorized" style="display: none; color: var(--text-secondary);">
      <h1>Akses Ditolak</h1>
      <p>Hanya admin (r86571601@gmail.com) yang dapat menulis artikel di blog ini.</p>
      <p><a href="/login">Login sebagai admin</a> atau kembali ke <a href="/">halaman utama</a>.</p>
    </div>

    <div id="editor-container" style="display: none;">
      <h1 style="margin-bottom: 24px;">Tulis Post Baru</h1>

      <form id="write-form">
        <div style="margin-bottom: 20px;">
          <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">Judul</label>
          <input type="text" id="post-title-input" placeholder="Misal: Membangun Web Tanpa Pusing" required />
        </div>

        <div style="margin-bottom: 20px;">
          <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">Slug URL</label>
          <input type="text" id="post-slug-input" placeholder="membangun-web-tanpa-pusing" required />
          <p style="font-size: 12px; color: var(--text-secondary); margin: 4px 0 0;">Otomatis dibuat dari judul, bisa disesuaikan.</p>
        </div>

        <div style="margin-bottom: 20px;">
          <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">Ringkasan (Satu Baris)</label>
          <input type="text" id="post-summary-input" placeholder="Catatan singkat tentang kesederhanaan membuat website." required />
        </div>

        <div style="margin-bottom: 24px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
            <label style="font-weight: 600; font-size: 14px;">Konten (Markdown)</label>
            <button type="button" id="btn-toggle-preview" style="background: none; border: none; color: var(--accent); cursor: pointer; font-size: 13px;">Lihat Preview</button>
          </div>
          <textarea id="post-content-input" rows="14" placeholder="Tulis isi tulisan kamu di sini menggunakan format Markdown..." required></textarea>
          
          <div id="preview-box" class="markdown-body" style="display: none; margin-top: 12px; padding: 16px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface);"></div>
        </div>

        <div style="display: flex; gap: 12px; align-items: center;">
          <button type="submit" class="btn-primary" id="btn-publish">Publikasikan Post</button>
          <a href="/" style="font-size: 14px; color: var(--text-secondary);">Batal</a>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { supabase, ADMIN_EMAIL } from '../lib/supabase';
  import { marked } from 'marked';

  async function checkAdmin() {
    const { data: { session } } = await supabase.auth.getSession();
    const authCheck = document.getElementById('auth-check')!;
    const unauthorized = document.getElementById('unauthorized')!;
    const editor = document.getElementById('editor-container')!;

    authCheck.style.display = 'none';

    if (!session || !session.user || session.user.email !== ADMIN_EMAIL) {
      unauthorized.style.display = 'block';
      return;
    }

    editor.style.display = 'block';
    setupEditor();
  }

  function slugify(text: string) {
    return text
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, '')
      .replace(/[\s_-]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function setupEditor() {
    const titleInput = document.getElementById('post-title-input') as HTMLInputElement;
    const slugInput = document.getElementById('post-slug-input') as HTMLInputElement;
    const contentInput = document.getElementById('post-content-input') as HTMLTextAreaElement;
    const previewBtn = document.getElementById('btn-toggle-preview') as HTMLButtonElement;
    const previewBox = document.getElementById('preview-box') as HTMLDivElement;
    const form = document.getElementById('write-form') as HTMLFormElement;
    const publishBtn = document.getElementById('btn-publish') as HTMLButtonElement;

    // Otomatis buat slug saat mengetik judul
    let isSlugManual = false;
    titleInput.addEventListener('input', () => {
      if (!isSlugManual) {
        slugInput.value = slugify(titleInput.value);
      }
    });

    slugInput.addEventListener('input', () => {
      isSlugManual = slugInput.value.length > 0;
    });

    // Toggle Preview
    let showPreview = false;
    previewBtn.addEventListener('click', () => {
      showPreview = !showPreview;
      if (showPreview) {
        previewBtn.textContent = 'Tutup Preview';
        previewBox.style.display = 'block';
        const parsed = marked.parse(contentInput.value || '*Belum ada konten.*');
        previewBox.innerHTML = typeof parsed === 'string' ? parsed : '';
      } else {
        previewBtn.textContent = 'Lihat Preview';
        previewBox.style.display = 'none';
      }
    });

    // Submit Post ke Supabase
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const title = titleInput.value.trim();
      const slug = slugInput.value.trim();
      const summary = (document.getElementById('post-summary-input') as HTMLInputElement).value.trim();
      const content = contentInput.value.trim();

      if (!title || !slug || !content) {
        alert('Mohon lengkapi semua kolom.');
        return;
      }

      publishBtn.disabled = true;
      publishBtn.textContent = 'Mempublikasikan...';

      const { error } = await supabase.from('posts').insert({
        title,
        slug,
        summary,
        content
      });

      publishBtn.disabled = false;
      publishBtn.textContent = 'Publikasikan Post';

      if (error) {
        if (error.code === '23505') {
          alert('Slug URL sudah dipakai oleh artikel lain. Silakan ubah slug-nya.');
        } else {
          alert('Gagal mempublikasikan post: ' + error.message);
        }
      } else {
        alert('Post berhasil dipublikasikan!');
        window.location.href = `/post?slug=${encodeURIComponent(slug)}`;
      }
    });
  }

  checkAdmin();
</script>
