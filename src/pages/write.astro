---
import Layout from '../layouts/Layout.astro';
---

<Layout title="New Post | aBlog by Satirr">
  <div class="wrap">
    <div id="auth-check" style="color: var(--text-secondary); font-size: 15px;">
      Checking authorization...
    </div>

    <div id="unauthorized" style="display: none; color: var(--text-secondary);">
      <h1>Access Restricted</h1>
      <p>Only the site administrator can create new posts.</p>
      <p><a href="/login">Sign in</a> with the authorized account or return to the <a href="/">homepage</a>.</p>
    </div>

    <div id="editor-container" style="display: none;">
      <h1 style="margin-bottom: 24px;">New Post</h1>

      <form id="write-form">
        <div style="margin-bottom: 20px;">
          <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">Title</label>
          <input type="text" id="post-title-input" placeholder="e.g. Building Static Blogs with Dynamic Powers" required />
        </div>

        <div style="margin-bottom: 20px;">
          <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">URL Slug</label>
          <input type="text" id="post-slug-input" placeholder="building-static-blogs" required />
          <p style="font-size: 12px; color: var(--text-secondary); margin: 4px 0 0;">Generated automatically from title, editable if needed.</p>
        </div>

        <div style="margin-bottom: 20px;">
          <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">Summary (Single line)</label>
          <input type="text" id="post-summary-input" placeholder="A brief one-line overview of the topic." required />
        </div>

        <div style="margin-bottom: 24px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
            <label style="font-weight: 600; font-size: 14px;">Content (Markdown)</label>
            <button type="button" id="btn-toggle-preview" style="background: none; border: none; color: var(--accent); cursor: pointer; font-size: 13px;">Preview</button>
          </div>
          <textarea id="post-content-input" rows="14" placeholder="Write your post content in Markdown format..." required></textarea>
          
          <div id="preview-box" class="markdown-body" style="display: none; margin-top: 12px; padding: 16px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface);"></div>
        </div>

        <div style="display: flex; gap: 12px; align-items: center;">
          <button type="submit" class="btn-primary" id="btn-publish">Publish post</button>
          <a href="/" style="font-size: 14px; color: var(--text-secondary);">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { supabase, ADMIN_EMAIL, isSupabaseConfigured } from '../lib/supabase';
  import { saveLocalPost } from '../lib/dummyPosts';
  import { marked } from 'marked';

  async function checkAdmin() {
    const authCheck = document.getElementById('auth-check')!;
    const unauthorized = document.getElementById('unauthorized')!;
    const editor = document.getElementById('editor-container')!;

    authCheck.style.display = 'none';

    // If Supabase is configured, enforce admin check
    if (isSupabaseConfigured) {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session || !session.user || !ADMIN_EMAIL || session.user.email !== ADMIN_EMAIL) {
          unauthorized.style.display = 'block';
          return;
        }
      } catch (e) {
        unauthorized.style.display = 'block';
        return;
      }
    }

    // Allowed (either admin verified or preview/local mode)
    editor.style.display = 'block';
    setupEditor();
  }

  function slugify(text: string) {
    return text
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, '')
      .replace(/[\s_-]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function setupEditor() {
    const titleInput = document.getElementById('post-title-input') as HTMLInputElement;
    const slugInput = document.getElementById('post-slug-input') as HTMLInputElement;
    const contentInput = document.getElementById('post-content-input') as HTMLTextAreaElement;
    const previewBtn = document.getElementById('btn-toggle-preview') as HTMLButtonElement;
    const previewBox = document.getElementById('preview-box') as HTMLDivElement;
    const form = document.getElementById('write-form') as HTMLFormElement;
    const publishBtn = document.getElementById('btn-publish') as HTMLButtonElement;

    let isSlugManual = false;
    titleInput.addEventListener('input', () => {
      if (!isSlugManual) {
        slugInput.value = slugify(titleInput.value);
      }
    });

    slugInput.addEventListener('input', () => {
      isSlugManual = slugInput.value.length > 0;
    });

    let showPreview = false;
    previewBtn.addEventListener('click', () => {
      showPreview = !showPreview;
      if (showPreview) {
        previewBtn.textContent = 'Hide Preview';
        previewBox.style.display = 'block';
        const parsed = marked.parse(contentInput.value || '*No content yet.*');
        previewBox.innerHTML = typeof parsed === 'string' ? parsed : '';
      } else {
        previewBtn.textContent = 'Preview';
        previewBox.style.display = 'none';
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const title = titleInput.value.trim();
      const slug = slugInput.value.trim();
      const summary = (document.getElementById('post-summary-input') as HTMLInputElement).value.trim();
      const content = contentInput.value.trim();

      if (!title || !slug || !content) {
        alert('Please complete all required fields.');
        return;
      }

      publishBtn.disabled = true;
      publishBtn.textContent = 'Publishing...';

      if (isSupabaseConfigured) {
        try {
          const { error } = await supabase.from('posts').insert({
            title,
            slug,
            summary,
            content
          });

          if (error && error.code === '23505') {
            publishBtn.disabled = false;
            publishBtn.textContent = 'Publish post';
            alert('This URL slug is already taken. Please choose another.');
            return;
          }
        } catch (err) {
          // Supabase network issue
        }
      }

      // Save to local storage for instant availability
      saveLocalPost({
        slug,
        title,
        summary,
        content,
        created_at: new Date().toISOString()
      });

      publishBtn.disabled = false;
      publishBtn.textContent = 'Publish post';

      alert('Post published successfully.');
      window.location.href = `/post?slug=${encodeURIComponent(slug)}`;
    });
  }

  checkAdmin();
</script>
