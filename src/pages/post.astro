---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Post | aBlog by Satirr">
  <div class="wrap">
    <div id="loading" style="color: var(--text-secondary); font-size: 15px;">
      Loading post...
    </div>

    <div id="not-found" style="display: none; color: var(--text-secondary);">
      <h1>Post not found</h1>
      <p>The post you are looking for may have been deleted or the URL is incorrect. Return to the <a href="/">homepage</a>.</p>
    </div>

    <article id="article-container" style="display: none;" class="post-article-font">
      <h1 id="post-title" style="margin-bottom: 8px;"></h1>
      <p class="meta" id="post-date" style="margin-bottom: 32px;"></p>
      
      <div class="markdown-body" id="post-content"></div>

      <!-- Admin Actions -->
      <div id="admin-actions" style="display: none; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--border);">
        <button id="btn-delete-post" class="btn-secondary" style="color: var(--danger); font-size: 13px;">Delete this post</button>
      </div>

      <!-- Comments Section -->
      <section style="margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--border);">
        <h2 style="font-size: 1.3rem; margin-top: 0; margin-bottom: 24px;">Discussion</h2>

        <!-- Comment Form (Accessible to logged in users) -->
        <div id="comment-form-container" style="display: none; margin-bottom: 32px;">
          <form id="comment-form">
            <textarea 
              id="comment-input" 
              placeholder="Leave a comment..." 
              rows="3" 
              required
              style="margin-bottom: 12px;"
            ></textarea>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <button type="submit" class="btn-primary" id="btn-submit-comment">Post comment</button>
              <span id="comment-user-badge" style="font-size: 13px; color: var(--text-secondary);"></span>
            </div>
          </form>
        </div>

        <div id="login-to-comment" style="display: none; margin-bottom: 32px; font-size: 15px; color: var(--text-secondary);">
          <a href="/login">Sign in</a> to join the conversation and leave a reply.
        </div>

        <!-- Comments List -->
        <div id="comments-loading" style="color: var(--text-secondary); font-size: 14px;">Loading comments...</div>
        <div id="comments-empty" style="display: none; color: var(--text-secondary); font-size: 14px;">No comments yet. Start the conversation!</div>
        <ul id="comments-list" style="list-style: none; padding: 0; margin: 0;"></ul>
      </section>
    </article>
  </div>
</Layout>

<script>
  import { supabase, ADMIN_EMAIL, isSupabaseConfigured } from '../lib/supabase';
  import { DUMMY_POSTS, getLocalPosts, deleteLocalPost, getDeletedSlugs, getLocalComments, saveLocalComment, deleteLocalComment } from '../lib/dummyPosts';
  import { marked } from 'marked';

  const params = new URLSearchParams(window.location.search);
  const slug = params.get('slug');

  let currentPost: any = null;
  let currentUser: any = null;
  let isSubmittingComment = false;

  async function init() {
    if (!slug) {
      showNotFound();
      return;
    }

    // Check if this post was marked as deleted
    const deletedSlugs = getDeletedSlugs();
    if (deletedSlugs.includes(slug)) {
      showNotFound();
      return;
    }

    // 1. Get Auth session if configured
    if (isSupabaseConfigured) {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        currentUser = session?.user || null;
      } catch (e) {
        currentUser = null;
      }
    }

    // Fallback: check demo session
    if (!currentUser) {
      const demoEmail = localStorage.getItem('satirr_demo_email');
      if (demoEmail) {
        currentUser = {
          id: 'demo-user',
          email: demoEmail
        };
      }
    }

    setupCommentAuthUI();

    // 2. Fetch post: first check local storage, then dummy fallback
    let post: any = getLocalPosts().find(p => p.slug === slug) || DUMMY_POSTS.find(p => p.slug === slug);

    if (isSupabaseConfigured) {
      try {
        const { data, error } = await supabase
          .from('posts')
          .select('*')
          .eq('slug', slug)
          .single();

        if (!error && data) {
          post = data;
        }
      } catch (e) {
        // Fallback to local
      }
    }

    document.getElementById('loading')!.style.display = 'none';

    if (!post) {
      showNotFound();
      return;
    }

    currentPost = post;
    renderPost(post);
    loadComments();
    setupAdminActions();
    setupCommentForm();
  }

  function showNotFound() {
    document.getElementById('loading')!.style.display = 'none';
    document.getElementById('article-container')!.style.display = 'none';
    document.getElementById('not-found')!.style.display = 'block';
  }

  function stripDuplicateHeading(content: string, postTitle: string) {
    if (!content) return '';
    const trimmed = content.trim();
    const headingMatch = trimmed.match(/^#\s+([^\r\n]+)/);
    if (headingMatch) {
      const headingText = headingMatch[1].replace(/[*_`]/g, '').trim().toLowerCase();
      const cleanTitle = (postTitle || '').replace(/[*_`]/g, '').trim().toLowerCase();
      if (headingText === cleanTitle || !cleanTitle) {
        return trimmed.replace(/^#\s+[^\r\n]+(?:\r?\n)*/, '').trim();
      }
    }
    return content;
  }

  function renderPost(post: any) {
    document.title = `${post.title} | aBlog by Satirr`;
    document.getElementById('article-container')!.style.display = 'block';
    document.getElementById('post-title')!.textContent = post.title;
    
    const d = new Date(post.created_at).toISOString().split('T')[0];
    document.getElementById('post-date')!.textContent = d;

    const bodyContent = stripDuplicateHeading(post.content || '', post.title || '');
    const htmlContent = marked.parse(bodyContent);
    document.getElementById('post-content')!.innerHTML = typeof htmlContent === 'string' ? htmlContent : '';
  }

  function setupCommentAuthUI() {
    const formBox = document.getElementById('comment-form-container')!;
    const loginBox = document.getElementById('login-to-comment')!;
    const badge = document.getElementById('comment-user-badge')!;

    if (currentUser) {
      formBox.style.display = 'block';
      loginBox.style.display = 'none';
      const name = currentUser.user_metadata?.display_name || currentUser.email.split('@')[0];
      badge.textContent = `Commenting as ${name}`;
    } else {
      formBox.style.display = 'none';
      loginBox.style.display = 'block';
    }
  }

  async function loadComments() {
    const loading = document.getElementById('comments-loading')!;
    const empty = document.getElementById('comments-empty')!;
    const list = document.getElementById('comments-list')!;

    let comments: any[] = [];
    const seenSignatures = new Set<string>();

    // 1. Fetch remote comments if Supabase is active
    if (isSupabaseConfigured) {
      try {
        const { data, error } = await supabase
          .from('comments')
          .select('*')
          .eq('post_slug', slug)
          .order('created_at', { ascending: true });

        if (!error && data && data.length > 0) {
          for (const sc of data) {
            comments.push(sc);
            // Sign by id and by content+email to prevent duplicates
            if (sc.id) seenSignatures.add(sc.id);
            seenSignatures.add(`${sc.user_email}_${sc.content.trim()}`);
          }
        }
      } catch (e) {}
    }

    // 2. Add local comments only if they do not already exist in remote
    const localComments = getLocalComments(slug!);
    for (const lc of localComments) {
      const sig = `${lc.user_email}_${lc.content.trim()}`;
      if (!seenSignatures.has(lc.id) && !seenSignatures.has(sig)) {
        comments.push(lc);
        seenSignatures.add(lc.id);
        seenSignatures.add(sig);
      }
    }

    loading.style.display = 'none';

    if (!comments || comments.length === 0) {
      empty.style.display = 'block';
      list.innerHTML = '';
      return;
    }

    empty.style.display = 'none';
    list.innerHTML = comments.map(c => {
      const isOwner = currentUser && (
        (c.user_id && currentUser.id === c.user_id) ||
        (c.user_email && currentUser.email === c.user_email) ||
        (ADMIN_EMAIL && currentUser.email === ADMIN_EMAIL)
      );

      const authorName = c.author_name || (c.user_email ? c.user_email.split('@')[0] : 'Reader');
      const dateStr = new Date(c.created_at).toLocaleString('en-US', {
        dateStyle: 'medium',
        timeStyle: 'short'
      });

      return `
        <li style="padding: 16px 0; border-bottom: 1px solid var(--border);">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
            <span style="font-weight: 600; font-size: 14px;">${escapeHtml(authorName)}</span>
            <div style="font-size: 12px; color: var(--text-secondary); display: flex; gap: 8px; align-items: center;">
              <span>${dateStr}</span>
              ${isOwner ? `<button class="btn-del-comment" data-id="${c.id}" style="background:none; border:none; color:var(--danger); cursor:pointer; font-size:12px; padding:0;">Delete</button>` : ''}
            </div>
          </div>
          <p style="margin: 0; font-size: 15px; line-height: 1.6; white-space: pre-wrap;">${escapeHtml(c.content)}</p>
        </li>
      `;
    }).join('');

    document.querySelectorAll('.btn-del-comment').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.target as HTMLElement).getAttribute('data-id');
        if (!confirm('Are you sure you want to delete this comment?')) return;
        
        if (id) {
          deleteLocalComment(id);
          if (isSupabaseConfigured) {
            try {
              await supabase.from('comments').delete().eq('id', id);
            } catch (err) {}
          }
        }
        loadComments();
      });
    });
  }

  function setupCommentForm() {
    const commentForm = document.getElementById('comment-form');
    if (!commentForm) return;

    commentForm.onsubmit = async (e) => {
      e.preventDefault();
      if (isSubmittingComment) return;

      if (!currentUser) {
        alert('Please sign in to leave a comment.');
        return;
      }

      const input = document.getElementById('comment-input') as HTMLTextAreaElement;
      const content = input.value.trim();
      if (!content) return;

      isSubmittingComment = true;
      const submitBtn = document.getElementById('btn-submit-comment') as HTMLButtonElement;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Posting...';

      const authorName = currentUser.user_metadata?.display_name || currentUser.email.split('@')[0];
      const tempId = 'c_' + Date.now();

      const newComment = {
        id: tempId,
        post_slug: slug!,
        user_id: currentUser.id !== 'demo-user' ? currentUser.id : null,
        user_email: currentUser.email,
        author_name: authorName,
        content: content,
        created_at: new Date().toISOString()
      };

      // If Supabase is active, push to remote
      if (isSupabaseConfigured) {
        try {
          const insertPayload: any = {
            post_slug: slug,
            user_email: currentUser.email,
            content: content
          };
          if (currentUser.id && currentUser.id !== 'demo-user') {
            insertPayload.user_id = currentUser.id;
          }

          const { data, error } = await supabase.from('comments').insert(insertPayload).select();
          if (!error && data && data[0]) {
            // Save Supabase canonical version locally to keep offline cache in sync
            saveLocalComment(data[0]);
          } else {
            saveLocalComment(newComment);
          }
        } catch (err) {
          saveLocalComment(newComment);
        }
      } else {
        saveLocalComment(newComment);
      }

      input.value = '';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Post comment';
      isSubmittingComment = false;

      loadComments();
    };
  }

  function setupAdminActions() {
    const isOwner = currentUser && (
      (ADMIN_EMAIL && currentUser.email === ADMIN_EMAIL) ||
      !isSupabaseConfigured
    );

    // Show delete button for admin or anyone in local preview mode
    const actions = document.getElementById('admin-actions')!;
    actions.style.display = 'block';

    const deleteBtn = document.getElementById('btn-delete-post');
    if (deleteBtn) {
      deleteBtn.onclick = async () => {
        if (!confirm(`Permanently delete post "${currentPost.title}"?`)) return;
        
        deleteBtn.textContent = 'Deleting...';
        (deleteBtn as HTMLButtonElement).disabled = true;

        // 1. Immediately delete locally & record slug as deleted
        deleteLocalPost(currentPost.slug);

        // 2. Delete from Supabase database by slug and by id
        if (isSupabaseConfigured) {
          try {
            await supabase.from('posts').delete().eq('slug', currentPost.slug);
            if (currentPost.id) {
              await supabase.from('posts').delete().eq('id', currentPost.id);
            }
          } catch (err) {
            console.warn('Supabase delete error:', err);
          }
        }

        alert('Post deleted.');
        window.location.href = '/';
      };
    }
  }

  function escapeHtml(str: string) {
    if (!str) return '';
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  init();
</script>
