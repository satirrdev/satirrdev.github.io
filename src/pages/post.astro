---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Post | aBlog by Satirr">
  <div class="wrap">
    <div id="loading" style="color: var(--text-secondary); font-size: 15px;">
      Loading post...
    </div>

    <div id="not-found" style="display: none; color: var(--text-secondary);">
      <h1>Post not found</h1>
      <p>The post you are looking for may have been deleted or the URL is incorrect. Return to the <a href="/">homepage</a>.</p>
    </div>

    <article id="article-container" style="display: none;" class="post-article-font">
      <h1 id="post-title" style="margin-bottom: 8px;"></h1>
      <p class="meta" id="post-date" style="margin-bottom: 32px;"></p>
      
      <div class="markdown-body" id="post-content"></div>

      <!-- Admin Actions -->
      <div id="admin-actions" style="display: none; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--border);">
        <button id="btn-delete-post" class="btn-secondary" style="color: var(--danger); font-size: 13px;">Delete this post</button>
      </div>

      <!-- Comments Section -->
      <section style="margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--border);">
        <h2 style="font-size: 1.3rem; margin-top: 0; margin-bottom: 24px;">Discussion</h2>

        <!-- Comment Form (Accessible to logged in users) -->
        <div id="comment-form-container" style="display: none; margin-bottom: 32px;">
          <form id="comment-form">
            <textarea 
              id="comment-input" 
              placeholder="Leave a comment..." 
              rows="3" 
              required
              style="margin-bottom: 12px;"
            ></textarea>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <button type="submit" class="btn-primary" id="btn-submit-comment">Post comment</button>
              <span id="comment-user-badge" style="font-size: 13px; color: var(--text-secondary);"></span>
            </div>
          </form>
        </div>

        <div id="login-to-comment" style="display: none; margin-bottom: 32px; font-size: 15px; color: var(--text-secondary);">
          <a href="/login">Sign in</a> to join the conversation and leave a reply.
        </div>

        <!-- Comments List -->
        <div id="comments-loading" style="color: var(--text-secondary); font-size: 14px;">Loading comments...</div>
        <div id="comments-empty" style="display: none; color: var(--text-secondary); font-size: 14px;">No comments yet. Start the conversation!</div>
        <ul id="comments-list" style="list-style: none; padding: 0; margin: 0;"></ul>
      </section>
    </article>
  </div>
</Layout>

<script>
  import { supabase, ADMIN_EMAIL, isSupabaseConfigured } from '../lib/supabase';
  import { 
    DUMMY_POSTS, 
    getLocalPosts, 
    deleteLocalPost, 
    getDeletedSlugs, 
    getLocalComments, 
    saveLocalComment, 
    deleteLocalComment,
    getLocalVote,
    saveLocalVote
  } from '../lib/dummyPosts';
  import { marked } from 'marked';

  const params = new URLSearchParams(window.location.search);
  const slug = params.get('slug');

  let currentPost: any = null;
  let currentUser: any = null;
  let isSubmittingComment = false;
  let cachedComments: any[] = [];

  async function init() {
    if (!slug) {
      showNotFound();
      return;
    }

    const deletedSlugs = getDeletedSlugs();
    if (deletedSlugs.includes(slug)) {
      showNotFound();
      return;
    }

    // 1. Get Auth session if configured
    if (isSupabaseConfigured) {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        currentUser = session?.user || null;
      } catch (e) {
        currentUser = null;
      }
    }

    // Fallback: check demo session
    if (!currentUser) {
      const demoEmail = localStorage.getItem('satirr_demo_email');
      if (demoEmail) {
        currentUser = {
          id: 'demo-user',
          email: demoEmail
        };
      }
    }

    setupCommentAuthUI();

    // 2. Fetch post
    let post: any = getLocalPosts().find(p => p.slug === slug) || DUMMY_POSTS.find(p => p.slug === slug);

    if (isSupabaseConfigured) {
      try {
        const { data, error } = await supabase
          .from('posts')
          .select('*')
          .eq('slug', slug)
          .single();

        if (!error && data) {
          post = data;
        }
      } catch (e) {}
    }

    document.getElementById('loading')!.style.display = 'none';

    if (!post) {
      showNotFound();
      return;
    }

    currentPost = post;
    renderPost(post);
    loadComments();
    setupAdminActions();
    setupCommentForm();
  }

  function showNotFound() {
    document.getElementById('loading')!.style.display = 'none';
    document.getElementById('article-container')!.style.display = 'none';
    document.getElementById('not-found')!.style.display = 'block';
  }

  function stripDuplicateHeading(content: string, postTitle: string) {
    if (!content) return '';
    const trimmed = content.trim();
    const headingMatch = trimmed.match(/^#\s+([^\r\n]+)/);
    if (headingMatch) {
      const headingText = headingMatch[1].replace(/[*_`]/g, '').trim().toLowerCase();
      const cleanTitle = (postTitle || '').replace(/[*_`]/g, '').trim().toLowerCase();
      if (headingText === cleanTitle || !cleanTitle) {
        return trimmed.replace(/^#\s+[^\r\n]+(?:\r?\n)*/, '').trim();
      }
    }
    return content;
  }

  function renderPost(post: any) {
    document.title = `${post.title} | aBlog by Satirr`;
    document.getElementById('article-container')!.style.display = 'block';
    document.getElementById('post-title')!.textContent = post.title;
    
    const d = new Date(post.created_at).toISOString().split('T')[0];
    document.getElementById('post-date')!.textContent = d;

    const bodyContent = stripDuplicateHeading(post.content || '', post.title || '');
    const htmlContent = marked.parse(bodyContent);
    document.getElementById('post-content')!.innerHTML = typeof htmlContent === 'string' ? htmlContent : '';
  }

  function setupCommentAuthUI() {
    const formBox = document.getElementById('comment-form-container')!;
    const loginBox = document.getElementById('login-to-comment')!;
    const badge = document.getElementById('comment-user-badge')!;

    if (currentUser) {
      formBox.style.display = 'block';
      loginBox.style.display = 'none';
      const name = currentUser.user_metadata?.display_name || currentUser.email.split('@')[0];
      badge.textContent = `Commenting as ${name}`;
    } else {
      formBox.style.display = 'none';
      loginBox.style.display = 'block';
    }
  }

  async function loadComments() {
    const loading = document.getElementById('comments-loading')!;
    const empty = document.getElementById('comments-empty')!;
    const list = document.getElementById('comments-list')!;

    let comments: any[] = [];
    const seenSignatures = new Set<string>();

    // 1. Fetch remote comments if Supabase is active
    if (isSupabaseConfigured) {
      try {
        const { data, error } = await supabase
          .from('comments')
          .select('*')
          .eq('post_slug', slug)
          .order('created_at', { ascending: true });

        if (!error && data && data.length > 0) {
          for (const sc of data) {
            comments.push(sc);
            if (sc.id) seenSignatures.add(sc.id);
            seenSignatures.add(`${sc.user_email}_${sc.content.trim()}`);
          }
        }
      } catch (e) {}
    }

    // 2. Fetch local comments
    const localComments = getLocalComments(slug!);
    for (const lc of localComments) {
      const sig = `${lc.user_email}_${lc.content.trim()}`;
      if (!seenSignatures.has(lc.id) && !seenSignatures.has(sig)) {
        comments.push(lc);
        seenSignatures.add(lc.id);
        seenSignatures.add(sig);
      }
    }

    // Calculate score & user vote status
    const userEmail = currentUser ? currentUser.email : '';
    for (const c of comments) {
      const voteVal = userEmail ? getLocalVote(c.id, userEmail) : 0;
      c.userVote = voteVal;
      c.score = (c.score || 0) + voteVal;
    }

    cachedComments = comments;
    loading.style.display = 'none';

    if (!comments || comments.length === 0) {
      empty.style.display = 'block';
      list.innerHTML = '';
      return;
    }

    empty.style.display = 'none';

    // Separate top-level comments and replies
    const topLevel = comments.filter(c => !c.parent_id);
    const repliesMap: { [key: string]: any[] } = {};
    for (const c of comments) {
      if (c.parent_id) {
        if (!repliesMap[c.parent_id]) repliesMap[c.parent_id] = [];
        repliesMap[c.parent_id].push(c);
      }
    }

    function renderCommentHTML(c: any, isReply = false): string {
      const isOwner = currentUser && (
        (c.user_id && currentUser.id === c.user_id) ||
        (c.user_email && currentUser.email === c.user_email) ||
        (ADMIN_EMAIL && currentUser.email === ADMIN_EMAIL)
      );

      const authorName = c.author_name || (c.user_email ? c.user_email.split('@')[0] : 'Reader');
      const dateStr = new Date(c.created_at).toLocaleString('en-US', {
        dateStyle: 'medium',
        timeStyle: 'short'
      });

      const replies = repliesMap[c.id] || [];

      return `
        <li style="padding: 14px 0; border-bottom: 1px solid var(--border); ${isReply ? 'margin-left: 28px; padding-left: 14px; border-left: 2px solid var(--border); border-bottom: none;' : ''}">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
            <span style="font-weight: 600; font-size: 14px;">${escapeHtml(authorName)}</span>
            <div style="font-size: 12px; color: var(--text-secondary); display: flex; gap: 8px; align-items: center;">
              <span>${dateStr}</span>
              ${isOwner ? `<button class="btn-del-comment" data-id="${c.id}" style="background:none; border:none; color:var(--danger); cursor:pointer; font-size:12px; padding:0;">Delete</button>` : ''}
            </div>
          </div>
          
          <p style="margin: 0 0 10px 0; font-size: 15px; line-height: 1.6; white-space: pre-wrap;">${escapeHtml(c.content)}</p>

          <!-- Vote & Reply Toolbar -->
          <div style="display: flex; align-items: center; gap: 14px; font-size: 13px; color: var(--text-secondary);">
            <!-- Upvote / Downvote -->
            <div style="display: flex; align-items: center; gap: 6px; background: var(--surface); padding: 2px 8px; border-radius: 4px; border: 1px solid var(--border);">
              <button class="btn-vote" data-id="${c.id}" data-type="1" style="background:none; border:none; cursor:pointer; color: ${c.userVote === 1 ? 'var(--accent)' : 'inherit'}; font-weight: bold; font-size: 13px; padding: 2px 4px;" title="Upvote">▲</button>
              <span id="score-${c.id}" style="font-weight: 600; min-width: 12px; text-align: center;">${c.score || 0}</span>
              <button class="btn-vote" data-id="${c.id}" data-type="-1" style="background:none; border:none; cursor:pointer; color: ${c.userVote === -1 ? 'var(--danger)' : 'inherit'}; font-weight: bold; font-size: 13px; padding: 2px 4px;" title="Downvote">▼</button>
            </div>

            <!-- Reply Button -->
            <button class="btn-toggle-reply" data-id="${c.id}" style="background:none; border:none; cursor:pointer; color: var(--accent); font-size: 13px; padding: 0;">Reply</button>
          </div>

          <!-- Inline Reply Form Container -->
          <div id="reply-box-${c.id}" style="display: none; margin-top: 14px; padding: 12px; background: var(--surface); border-radius: 6px; border: 1px solid var(--border);">
            <textarea id="reply-input-${c.id}" rows="2" placeholder="Write a reply..." style="margin-bottom: 8px;"></textarea>
            <div style="display: flex; gap: 8px;">
              <button class="btn-primary btn-submit-reply" data-parent-id="${c.id}" style="font-size: 13px; padding: 6px 12px;">Send Reply</button>
              <button class="btn-secondary btn-cancel-reply" data-parent-id="${c.id}" style="font-size: 13px; padding: 6px 12px;">Cancel</button>
            </div>
          </div>

          <!-- Nested Replies -->
          ${replies.length > 0 ? `
            <ul style="list-style: none; padding: 0; margin-top: 10px;">
              ${replies.map(r => renderCommentHTML(r, true)).join('')}
            </ul>
          ` : ''}
        </li>
      `;
    }

    list.innerHTML = topLevel.map(c => renderCommentHTML(c)).join('');

    // Attach Event Listeners
    attachCommentInteractions();
  }

  function attachCommentInteractions() {
    // 1. Delete Comment
    document.querySelectorAll('.btn-del-comment').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.target as HTMLElement).getAttribute('data-id');
        if (!confirm('Are you sure you want to delete this comment?')) return;
        
        if (id) {
          deleteLocalComment(id);
          if (isSupabaseConfigured) {
            try {
              await supabase.from('comments').delete().eq('id', id);
            } catch (err) {}
          }
        }
        loadComments();
      });
    });

    // 2. Upvote & Downvote
    document.querySelectorAll('.btn-vote').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!currentUser) {
          alert('Please sign in to vote on comments.');
          return;
        }

        const target = e.currentTarget as HTMLElement;
        const commentId = target.getAttribute('data-id')!;
        const voteType = parseInt(target.getAttribute('data-type')!, 10);
        const currentVote = getLocalVote(commentId, currentUser.email);

        // Toggle vote: if already upvoted, click again removes vote
        const newVote = currentVote === voteType ? 0 : voteType;
        saveLocalVote(commentId, currentUser.email, newVote);

        if (isSupabaseConfigured) {
          try {
            if (newVote === 0) {
              await supabase.from('comment_votes').delete().match({
                comment_id: commentId,
                user_email: currentUser.email
              });
            } else {
              await supabase.from('comment_votes').upsert({
                comment_id: commentId,
                user_email: currentUser.email,
                vote: newVote
              });
            }
          } catch (err) {}
        }

        loadComments();
      });
    });

    // 3. Toggle Reply Form
    document.querySelectorAll('.btn-toggle-reply').forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (!currentUser) {
          alert('Please sign in to reply to comments.');
          return;
        }
        const commentId = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
        const replyBox = document.getElementById(`reply-box-${commentId}`)!;
        replyBox.style.display = replyBox.style.display === 'none' ? 'block' : 'none';
        if (replyBox.style.display === 'block') {
          const input = document.getElementById(`reply-input-${commentId}`) as HTMLTextAreaElement;
          input?.focus();
        }
      });
    });

    // 4. Cancel Reply
    document.querySelectorAll('.btn-cancel-reply').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const parentId = (e.currentTarget as HTMLElement).getAttribute('data-parent-id')!;
        const replyBox = document.getElementById(`reply-box-${parentId}`)!;
        replyBox.style.display = 'none';
      });
    });

    // 5. Submit Reply
    document.querySelectorAll('.btn-submit-reply').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!currentUser) return;
        const parentId = (e.currentTarget as HTMLElement).getAttribute('data-parent-id')!;
        const input = document.getElementById(`reply-input-${parentId}`) as HTMLTextAreaElement;
        const content = input.value.trim();
        if (!content) return;

        const submitBtn = e.currentTarget as HTMLButtonElement;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';

        const authorName = currentUser.user_metadata?.display_name || currentUser.email.split('@')[0];
        const newReply = {
          id: 'c_' + Date.now(),
          post_slug: slug!,
          parent_id: parentId,
          user_id: currentUser.id !== 'demo-user' ? currentUser.id : null,
          user_email: currentUser.email,
          author_name: authorName,
          content: content,
          created_at: new Date().toISOString()
        };

        saveLocalComment(newReply);

        if (isSupabaseConfigured) {
          try {
            const insertPayload: any = {
              post_slug: slug,
              parent_id: parentId,
              user_email: currentUser.email,
              content: content
            };
            if (currentUser.id && currentUser.id !== 'demo-user') {
              insertPayload.user_id = currentUser.id;
            }
            const { data } = await supabase.from('comments').insert(insertPayload).select();
            if (data && data[0]) {
              saveLocalComment(data[0]);
            }
          } catch (err) {}
        }

        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Reply';
        input.value = '';
        loadComments();
      });
    });
  }

  function setupCommentForm() {
    const commentForm = document.getElementById('comment-form');
    if (!commentForm) return;

    commentForm.onsubmit = async (e) => {
      e.preventDefault();
      if (isSubmittingComment) return;

      if (!currentUser) {
        alert('Please sign in to leave a comment.');
        return;
      }

      const input = document.getElementById('comment-input') as HTMLTextAreaElement;
      const content = input.value.trim();
      if (!content) return;

      isSubmittingComment = true;
      const submitBtn = document.getElementById('btn-submit-comment') as HTMLButtonElement;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Posting...';

      const authorName = currentUser.user_metadata?.display_name || currentUser.email.split('@')[0];
      const tempId = 'c_' + Date.now();

      const newComment = {
        id: tempId,
        post_slug: slug!,
        parent_id: null,
        user_id: currentUser.id !== 'demo-user' ? currentUser.id : null,
        user_email: currentUser.email,
        author_name: authorName,
        content: content,
        created_at: new Date().toISOString()
      };

      if (isSupabaseConfigured) {
        try {
          const insertPayload: any = {
            post_slug: slug,
            user_email: currentUser.email,
            content: content
          };
          if (currentUser.id && currentUser.id !== 'demo-user') {
            insertPayload.user_id = currentUser.id;
          }

          const { data, error } = await supabase.from('comments').insert(insertPayload).select();
          if (!error && data && data[0]) {
            saveLocalComment(data[0]);
          } else {
            saveLocalComment(newComment);
          }
        } catch (err) {
          saveLocalComment(newComment);
        }
      } else {
        saveLocalComment(newComment);
      }

      input.value = '';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Post comment';
      isSubmittingComment = false;

      loadComments();
    };
  }

  function setupAdminActions() {
    const actions = document.getElementById('admin-actions')!;
    actions.style.display = 'block';

    const deleteBtn = document.getElementById('btn-delete-post');
    if (deleteBtn) {
      deleteBtn.onclick = async () => {
        if (!confirm(`Permanently delete post "${currentPost.title}"?`)) return;
        
        deleteBtn.textContent = 'Deleting...';
        (deleteBtn as HTMLButtonElement).disabled = true;

        deleteLocalPost(currentPost.slug);

        if (isSupabaseConfigured) {
          try {
            await supabase.from('posts').delete().eq('slug', currentPost.slug);
            if (currentPost.id) {
              await supabase.from('posts').delete().eq('id', currentPost.id);
            }
          } catch (err) {
            console.warn('Supabase delete error:', err);
          }
        }

        alert('Post deleted.');
        window.location.href = '/';
      };
    }
  }

  function escapeHtml(str: string) {
    if (!str) return '';
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  init();
</script>
