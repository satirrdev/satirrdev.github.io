---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Profile | aBlog by Satirr">
  <div class="wrap" style="max-width: 540px; margin: 0 auto;">
    <div id="auth-check" style="color: var(--text-secondary); font-size: 15px;">
      Checking authorization...
    </div>

    <div id="unauthorized" style="display: none;">
      <h1 style="margin-bottom: 8px;">Please Sign In</h1>
      <p style="color: var(--text-secondary); margin-bottom: 24px;">
        You need to be signed in to view and edit your profile.
      </p>
      <a href="/login" class="btn-primary" style="display: inline-block; text-decoration: none;">Sign In</a>
    </div>

    <div id="profile-container" style="display: none;">
      <h1 style="margin-bottom: 8px;">Your Profile</h1>
      <p style="color: var(--text-secondary); margin-bottom: 28px;">
        Manage your public identity, display name, and bio for comments.
      </p>

      <div id="msg-box" style="display: none; padding: 10px 14px; border-radius: 6px; font-size: 14px; margin-bottom: 20px;"></div>

      <form id="profile-form">
        <div style="margin-bottom: 18px;">
          <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">Email address</label>
          <input type="email" id="user-email" disabled style="opacity: 0.7; cursor: not-allowed; background: var(--surface);" />
          <span style="display: block; font-size: 12px; color: var(--text-secondary); margin-top: 4px;">Email is tied to your account and cannot be modified here.</span>
        </div>

        <div style="margin-bottom: 18px;">
          <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">Display Name</label>
          <input type="text" id="display-name" placeholder="How you want to be called" required />
        </div>

        <div style="margin-bottom: 18px;">
          <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">Bio</label>
          <textarea id="bio" rows="3" placeholder="Tell readers a bit about yourself..."></textarea>
        </div>

        <div style="margin-bottom: 24px;">
          <label style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 6px;">Website or External Link</label>
          <input type="url" id="website" placeholder="https://yourwebsite.com" />
        </div>

        <div style="display: flex; gap: 12px;">
          <button type="submit" class="btn-primary" id="btn-save">Save Profile</button>
          <a href="/" class="btn-secondary" style="font-size: 14px; text-decoration: none;">Done</a>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { supabase, ADMIN_EMAIL } from '../lib/supabase';

  let currentUser: any = null;
  let initialDisplayName = '';

  const authCheck = document.getElementById('auth-check')!;
  const unauthorized = document.getElementById('unauthorized')!;
  const profileContainer = document.getElementById('profile-container')!;
  const emailInput = document.getElementById('user-email') as HTMLInputElement;
  const nameInput = document.getElementById('display-name') as HTMLInputElement;
  const bioInput = document.getElementById('bio') as HTMLTextAreaElement;
  const websiteInput = document.getElementById('website') as HTMLInputElement;
  const saveBtn = document.getElementById('btn-save') as HTMLButtonElement;
  const msgBox = document.getElementById('msg-box')!;
  const form = document.getElementById('profile-form') as HTMLFormElement;

  function showMessage(text: string, isError = false) {
    msgBox.style.display = 'block';
    msgBox.textContent = text;
    if (isError) {
      msgBox.style.background = 'rgba(235, 87, 87, 0.1)';
      msgBox.style.color = 'var(--danger)';
      msgBox.style.border = '1px solid var(--danger)';
    } else {
      msgBox.style.background = 'var(--surface)';
      msgBox.style.color = 'var(--text)';
      msgBox.style.border = '1px solid var(--border)';
    }
  }

  async function loadProfile() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session || !session.user) {
        authCheck.style.display = 'none';
        unauthorized.style.display = 'block';
        return;
      }

      currentUser = session.user;
      authCheck.style.display = 'none';
      profileContainer.style.display = 'block';

      emailInput.value = currentUser.email || '';

      const meta = currentUser.user_metadata || {};
      nameInput.value = meta.display_name || meta.name || '';
      bioInput.value = meta.bio || '';
      websiteInput.value = meta.website || '';

      const { data, error } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', currentUser.id)
        .maybeSingle();

      if (!error && data) {
        if (data.display_name) nameInput.value = data.display_name;
        if (data.bio) bioInput.value = data.bio;
        if (data.website) websiteInput.value = data.website;
      }

      initialDisplayName = nameInput.value.trim();
    } catch (e) {
      authCheck.style.display = 'none';
      unauthorized.style.display = 'block';
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msgBox.style.display = 'none';

    const displayName = nameInput.value.trim();
    const bio = bioInput.value.trim();
    const website = websiteInput.value.trim();

    const isAdmin = Boolean(ADMIN_EMAIL && currentUser.email === ADMIN_EMAIL);
    const isNameChanging = displayName !== initialDisplayName;
    const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;

    if (isNameChanging && !isAdmin) {
      const meta = currentUser.user_metadata || {};
      const lastChanged = meta.username_changed_at ? new Date(meta.username_changed_at).getTime() : 0;
      const now = Date.now();

      if (lastChanged && (now - lastChanged) < SEVEN_DAYS_MS) {
        const daysLeft = Math.ceil((SEVEN_DAYS_MS - (now - lastChanged)) / (24 * 60 * 60 * 1000));
        showMessage(`You can only change your display name once every 7 days. Please wait ${daysLeft} more day(s).`, true);
        return;
      }
    }

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    try {
      const updateData: any = {
        display_name: displayName,
        bio: bio,
        website: website
      };

      if (isNameChanging && !isAdmin) {
        updateData.username_changed_at = new Date().toISOString();
      }

      const { data: updatedUser, error: authError } = await supabase.auth.updateUser({
        data: updateData
      });

      if (authError) {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Profile';
        showMessage(authError.message, true);
        return;
      }

      if (updatedUser?.user) {
        currentUser = updatedUser.user;
      }

      initialDisplayName = displayName;

      try {
        await supabase.from('profiles').upsert({
          id: currentUser.id,
          display_name: displayName,
          bio: bio,
          website: website,
          updated_at: new Date().toISOString()
        });
      } catch (tableErr) {
        console.warn('Profile table upsert error:', tableErr);
      }

      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Profile';
      showMessage('Profile updated successfully.');
    } catch (err: any) {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Profile';
      showMessage(err?.message || 'Error updating profile', true);
    }
  });

  loadProfile();
</script>
