---
import Layout from '../layouts/Layout.astro';
---

<Layout title="aBlog by Satirr">
  <div class="wrap">
    <h1>Writing</h1>
    <p class="intro" style="color: var(--text-secondary); margin-bottom: 32px;">
      Short notes on daily engineering and concepts I am currently exploring.
    </p>

    <!-- Loading State -->
    <div id="loading" style="color: var(--text-secondary); font-size: 15px;">
      Loading posts...
    </div>

    <!-- Empty/Error State -->
    <div id="error-box" style="display: none; color: var(--text-secondary); font-size: 15px;">
      No posts available yet.
    </div>

    <!-- Posts List -->
    <ul class="post-list" id="post-list" style="display: none;"></ul>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { waitForVerification } from '../lib/verification';

  async function loadPosts() {
    const loading = document.getElementById('loading');
    const errorBox = document.getElementById('error-box');
    const postList = document.getElementById('post-list');

    try {
      const { data: posts, error } = await supabase
        .from('posts')
        .select('slug, title, summary, created_at')
        .order('created_at', { ascending: false });

      if (loading) loading.style.display = 'none';

      if (error || !posts || posts.length === 0) {
        if (postList) postList.style.display = 'none';
        if (errorBox) errorBox.style.display = 'block';
        return;
      }

      if (errorBox) errorBox.style.display = 'none';
      if (postList) {
        postList.style.display = 'block';
        postList.innerHTML = posts.map(post => {
          const dateStr = new Date(post.created_at).toISOString().split('T')[0];
          const postUrl = `/post?slug=${encodeURIComponent(post.slug)}`;
          return `
            <li onclick="window.location.href='${postUrl}'">
              <a class="title" href="${postUrl}">${escapeHtml(post.title)}</a>
              <p class="meta">${dateStr}</p>
              <p class="summary">${escapeHtml(post.summary)}</p>
            </li>
          `;
        }).join('');
      }
    } catch (err) {
      if (loading) loading.style.display = 'none';
      if (postList) postList.style.display = 'none';
      if (errorBox) errorBox.style.display = 'block';
    }
  }

  function escapeHtml(str: string) {
    if (!str) return '';
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  waitForVerification().then(loadPosts);
</script>
