---
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">aBlog by Satirr</a>
    <nav class="nav">
      <a href="/">Posts</a>
      <a href="/about">About</a>
      <a href="/profile" id="nav-profile" style="display: none;">Profile</a>
      <a href="/write" id="nav-write" style="display: none;">Write</a>
      
      <div id="auth-status" class="user-badge">
        <a href="/login" id="nav-login">Sign in</a>
      </div>
    </nav>
  </div>
</header>

<script>
  import { supabase, ADMIN_EMAIL } from '../lib/supabase';
  import { waitForVerification } from '../lib/verification';

  async function updateAuthUI() {
    const authStatus = document.getElementById('auth-status');
    const navWrite = document.getElementById('nav-write');
    const navProfile = document.getElementById('nav-profile');

    if (!authStatus) return;

    await waitForVerification();

    try {
      const { data: { session } } = await supabase.auth.getSession();

      if (session && session.user) {
        const email = session.user.email || 'User';
        const isAdmin = Boolean(ADMIN_EMAIL && email === ADMIN_EMAIL);
        const displayName = session.user.user_metadata?.display_name || email.split('@')[0];

        if (navProfile) navProfile.style.display = 'inline-block';
        if (navWrite) navWrite.style.display = isAdmin ? 'inline-block' : 'none';

        authStatus.innerHTML = `
          <a href="/profile" title="${email}" style="color: inherit; text-decoration: none;">${isAdmin ? 'Admin' : displayName}</a>
          <button id="btn-logout" type="button">Sign out</button>
        `;

        const btnLogout = document.getElementById('btn-logout');
        if (btnLogout) {
          btnLogout.addEventListener('click', async () => {
            await supabase.auth.signOut();
            window.location.reload();
          });
        }
      } else {
        if (navProfile) navProfile.style.display = 'none';
        if (navWrite) navWrite.style.display = 'none';
        authStatus.innerHTML = `<a href="/login" id="nav-login">Sign in</a>`;
      }
    } catch (e) {
      if (navProfile) navProfile.style.display = 'none';
      if (navWrite) navWrite.style.display = 'none';
      authStatus.innerHTML = `<a href="/login" id="nav-login">Sign in</a>`;
    }
  }

  updateAuthUI();
  supabase.auth.onAuthStateChange(() => {
    updateAuthUI();
  });
</script>
